generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["notifications_service", "auth_service", "orders_service", "references_service"]
}

// ─────────────────────────────────────────
// Schema: references_service (read-only)
// ─────────────────────────────────────────

model City {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(100)
  code     String  @unique @db.VarChar(20)
  isActive Boolean @default(true) @map("is_active")

  orders Order[]

  @@schema("references_service")
  @@map("cities")
}

model Rk {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(100)
  code     String  @unique @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  orders Order[]

  @@schema("references_service")
  @@map("rk")
}

model EquipmentType {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(100)
  code     String  @unique @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  orders Order[]

  @@schema("references_service")
  @@map("equipment_types")
}

// ─────────────────────────────────────────
// Schema: auth_service (read-only)
// ─────────────────────────────────────────

model Director {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(255)
  cityIds Int[]   @default([]) @map("city_ids")
  tgId    String? @map("tg_id") @db.VarChar(50)
  chatId  String? @map("chat_id") @db.VarChar(50)
  status  String  @db.VarChar(50)

  @@index([cityIds])
  @@schema("auth_service")
  @@map("directors")
}

model Master {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(255)
  cityIds Int[]   @default([]) @map("city_ids")
  chatId  String? @map("chat_id") @db.VarChar(50)
  status  String  @db.VarChar(50)

  @@schema("auth_service")
  @@map("masters")
}

// ─────────────────────────────────────────
// Schema: orders_service (read-only)
// ─────────────────────────────────────────

model Order {
  id              Int       @id @default(autoincrement())
  cityId          Int       @map("city_id")
  rkId            Int       @map("rk_id")
  equipmentTypeId Int       @map("equipment_type_id")
  masterId        Int?      @map("master_id")
  operatorId      Int       @map("operator_id")
  statusId        Int       @map("status_id")
  clientName      String    @map("client_name") @db.VarChar(255)
  phone           String    @db.VarChar(20)
  address         String    @db.VarChar(500)
  dateMeeting     DateTime  @map("date_meeting")
  result          Decimal?  @db.Decimal(10, 2)
  expenditure     Decimal?  @db.Decimal(10, 2)
  clean           Decimal?  @db.Decimal(10, 2)
  masterChange    Decimal?  @map("master_change") @db.Decimal(10, 2)
  closingAt       DateTime? @map("closing_at")
  dateCloseMod    DateTime? @map("date_close_mod")
  createdAt       DateTime  @default(now()) @map("created_at")

  city          City          @relation(fields: [cityId], references: [id])
  rk            Rk            @relation(fields: [rkId], references: [id])
  equipmentType EquipmentType @relation(fields: [equipmentTypeId], references: [id])

  @@schema("orders_service")
  @@map("orders")
}

// ─────────────────────────────────────────
// Schema: notifications_service
// ─────────────────────────────────────────

/// Логи уведомлений (Telegram, SMS, Email)
model NotificationLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")        /// ID получателя
  userType  String   @map("user_type") @db.VarChar(20) /// Тип получателя (operator/director/master)
  channel   String   @db.VarChar(20)        /// telegram/sms/email
  message   String   @db.Text              /// Текст сообщения
  status    String   @db.VarChar(20)        /// sent/failed/pending
  error     String?  @db.Text              /// Текст ошибки
  metadata  Json?    @db.JsonB             /// Доп. данные
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, userType])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@index([channel, status])
  @@schema("notifications_service")
  @@map("notification_logs")
}
